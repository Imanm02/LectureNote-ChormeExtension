{
  "name": "lecture-note-chrome-extension",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:extension": "node scripts/validate-extension.mjs",
    "lint": "eslint src tests scripts/*.mjs eslint.config.js",
    "test": "node --test",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:coverage": "node --experimental-test-coverage --test",
    "validate": "npm run lint && npm test && npm run check:extension"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "^29.0.1",
    "playwright": "^1.63.0"
  },
  "engines": {
    "node": ">=24"
  }
}
