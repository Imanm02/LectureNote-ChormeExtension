{
  "name": "lecture-note-chrome-extension",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "scripts": {
    "check:extension": "node scripts/validate-extension.mjs",
    "check:package": "node scripts/validate-package.mjs",
    "lint": "eslint src tests scripts/*.mjs eslint.config.js",
    "package:extension": "node scripts/package-extension.mjs",
    "preflight": "npm audit --audit-level=moderate && npm run lint && npm run test:coverage && npm run check:extension",
    "release:check": "npm run preflight && npm run test:browser && npm run package:extension && npm run check:package && npm run test:browser:package",
    "store:screenshots": "node scripts/store-screenshots.mjs",
    "test": "node --test",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:package": "node scripts/package-browser-smoke.mjs",
    "test:coverage": "node --experimental-test-coverage --test --test-coverage-lines=87 --test-coverage-branches=80 --test-coverage-functions=83",
    "validate": "npm run lint && npm test && npm run check:extension"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=11.12.1 <12"
  }
}
